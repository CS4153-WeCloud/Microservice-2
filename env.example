PORT=3002
NODE_ENV=development

# User Service URL (for foreign key validation)
USER_SERVICE_URL=http://localhost:3001

# Local Development Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=password
DB_NAME=route_service_db
DB_PORT=3306

# Cloud SQL Configuration (for Cloud Run deployment)
# Option 1: Unix Socket (Recommended for Cloud Run)
# NODE_ENV=production
# INSTANCE_CONNECTION_NAME=PROJECT_ID:REGION:INSTANCE_NAME
# DB_SOCKET_PATH=/cloudsql
# DB_USER=your_cloud_sql_user
# DB_PASSWORD=your_cloud_sql_password
# DB_NAME=route_service_db

# Option 2: TCP/IP Connection
# INSTANCE_CONNECTION_NAME=PROJECT_ID:REGION:INSTANCE_NAME
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=your_cloud_sql_user
# DB_PASSWORD=your_cloud_sql_password
# DB_NAME=route_service_db
