# Environment variables for Route & Group Service

# The port this service will run on
PORT=3002

# The environment mode (development or production)
NODE_ENV=development

# URL for the Auth & User Service (Microservice 1)
USER_SERVICE_URL=https://user-service-1081353560639.us-central1.run.app

# --- Local Development Database Configuration ---
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_local_mysql_password
DB_NAME=route_and_group_service_db
DB_PORT=3306

# --- Production Cloud SQL Configuration (for GCP VM) ---
# INSTANCE_CONNECTION_NAME=your-gcp-project-id:your-region:your-instance-name